version 1.0

time "televendas":
    vendedores todostelevendas ativados

parametros "Prospects do vendedor":
    do time("televendas")
    quando no ciclo de vida prospect com o vendedor
    frequencia de 28 dias

parametros "Unica compra com o vendedor":
    do time("televendas")
    quando unica compra com o vendedor
    frequencia de 21 dias

parametros "Curva C com compra nos ultimos 90 dias":
    do time("televendas")
    quando curva C com a empresa
        e recencia de positivacao em 90 dias
    frequencia de 7 dias

parametros "Compra nos ultimos 90 dias":
    do time("televendas")
    quando recencia de positivacao em 90 dias
    frequencia de 14 dias

parametros "Compra entre 91 e 180 dias":
    do time("televendas")
    quando recencia de positivacao em 180 dias
    frequencia de 28 dias

parametros "Resgate de inativos":
    do time("televendas")
    frequencia de 45 dias
