version 1.0

time "televendas":
    vendedores todostelevendas

parametros "Nao agendar baixados na Receita Federal":
    do time("televendas")
    quando status na receita federal definido como baixada
    nao agendar

parametros "Prospects":
    do time("televendas")
    quando no ciclo de vida prospect com a empresa
    frequencia de 14 dias

parametros "Sul Sudeste Centro-Oeste - Material de Construcao - Ativos - Curva A":
    do time("televendas")
    quando uf do estado igual("PR", "SC", "RS", "SP", "RJ", "MG", "ES", "GO", "MT", "MS", "DF")
        e ramo de atividade igual("Material de Construcao", "Ferragista", "Agropecuaria", "Home Center")
        e recencia de positivacao em 120 dias
        e curva A com a empresa
        e media faturada no ano com a empresa maior que R$ 25000
    frequencia de 14 dias

