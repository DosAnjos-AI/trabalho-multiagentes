version 1.0

time "televendas":
    vendedores todostelevendas ativados

parametros "Prospects":
    do time("televendas")
    quando no ciclo de vida prospect com o vendedor
    frequencia de 28 dias

parametros "Unica compra":
    do time("televendas")
    quando unica compra com o vendedor
    frequencia de 21 dias

parametros "Curva C":
    do time("televendas")
    quando recencia de positivacao em 90 dias
        e curva C com a empresa
    frequencia de 7 dias

parametros "Curva A e B":
    do time("televendas")
    quando recencia de positivacao em 90 dias
    frequencia de 14 dias

parametros "Entre 91 e 180 dias":
    do time("televendas")
    quando recencia de positivacao em 180 dias
    frequencia de 28 dias

parametros "Resgate de clientes inativos":
    do time("televendas")
    frequencia de 45 dias
