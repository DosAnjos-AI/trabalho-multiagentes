    quando ramo de atividade igual("CONS. FINAL")
    # frequencia nao informada na descricao; valor inferido pelo padrao do grupo
    frequencia de 28 dias

parametros "Clientes que hoje não se enquadraram nas regras padrão":
    do time("televendas")
    nao agendar
