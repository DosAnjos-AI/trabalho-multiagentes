version 1.0

time "televendas":
    vendedores todostelevendas ativados

parametros "nao comprou com o vendedor":
    do time("televendas")
    quando prospects do vendedor
    frequencia de 28 dias

parametros "unica compra com o vendedor":
    do time("televendas")
    quando unica compra com o vendedor
    frequencia de 21 dias

parametros "comprou com o vendedor em 90 dias curva C":
    do time("televendas")
    quando recencia de positivacao do vendedor em 90 dias
    e curva C com a empresa
    frequencia de 7 dias

parametros "comprou com o vendedor em 90 dias":
    do time("televendas")
    quando recencia de positivacao do vendedor em 90 dias
    frequencia de 14 dias

parametros "comprou com o vendedor entre 91 e 180 dias":
    do time("televendas")
    quando recencia de positivacao do vendedor entre 91 dias e 180 dias
    frequencia de 28 dias

parametros "resto":
    do time("televendas")
    frequencia de 45 dias
